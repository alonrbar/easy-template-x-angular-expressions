{
    "compileOnSave": true,
    "compilerOptions": {

        // --- output --- //

        "declaration": true,
        "declarationDir": "./dist/types",
        "outDir": "./.tmp/compiled",
        "sourceMap": true,
        "target": "es2022",
        "module": "es2022",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        // --- module resolution --- //

        "typeRoots" : ["./node_modules/@types","./src/@types"],
        "types": ["jest", "node", "ts-nameof"],
        "moduleResolution": "bundler",
        "paths": {
            "src": ["./src/index.ts"],
            "src/*": ["./src/*"],
            "test/*": ["./test/*"]
        },

        // --- validation options --- //

        "alwaysStrict": true,
        "allowSyntheticDefaultImports": true,
        "allowUnreachableCode": false,
        "forceConsistentCasingInFileNames": true,
        "lib": ["dom", "es2023"],
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "skipLibCheck": true,
        "strictNullChecks": false
    },
    "exclude": [
        "node_modules",
        ".tmp",
        "dist"
    ]
}
